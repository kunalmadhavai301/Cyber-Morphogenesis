# ML-KEM Benchmarking Platform Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_SECRET_KEY=dev-insecure-secret-key-change-in-production
HOST=127.0.0.1
PORT=5000

# Cryptography Settings
DEFAULT_KEM_ALGORITHM=ML-KEM-768
SESSION_KEY_TTL_SECONDS=900

# Benchmark Bounds
MAX_BENCHMARK_TRIALS=10000
MAX_WARMUP_TRIALS=500
MAX_CONCURRENT_BENCHMARKS=1

# Storage
DATABASE_PATH=data/benchmark_experiments.sqlite3
RESULTS_EXPORT_DIR=results
